<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.electroneumhackathon.etnvegas.GamesListFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@drawable/gradient_background">

    <!-- First TextView -->
    <TextView
        android:id="@+id/title_of_casino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:fontFamily="@font/marko_one"
        android:text="Casino"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="List of games"
            android:fillViewport="true"
            android:isScrollContainer="true"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="always"
            android:paddingBottom="100dp"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title_of_casino">


            <LinearLayout
                android:id="@+id/linear_inside_scroll_casino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:scrollbars="vertical" >


                <!-- Card 1 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/casino_slot_machine"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/slot_listed_lottie_animation"
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/slot_lottie_list" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/marko_one"
                            android:gravity="center"
                            android:text="Slot Machine"
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>



                <!-- Card 2 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/casino_fortune_wheel"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/fortune_wheel_lottie_animation"
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/fortune_wheel_lottie" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/marko_one"
                            android:gravity="center"
                            android:text="Fortune Wheel"
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Card 3 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/roulette_game_casino"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/roulette_wheel_lottie_animation"
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/roulette_wheel_lottie" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/marko_one"
                            android:gravity="center"
                            android:text="European Roulette"
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <!-- Card 4 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/casino_dice_game"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginBottom="18dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/dice_lottie_animation"
                            android:layout_width="100dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/dice_animation" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/marko_one"
                            android:gravity="center"
                            android:text="Mystic Dice"
                            android:textColor="@android:color/black"
                            android:textSize="16sp" />


                    </LinearLayout>
                </androidx.cardview.widget.CardView>



            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
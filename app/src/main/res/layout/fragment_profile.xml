<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.electroneumhackathon.etnvegas.ProfileFragment">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/address_layout_linear"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/gradient_background"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp"
            android:paddingTop="25dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="35dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/slot_gradient_layout_background"
                android:fontFamily="@font/marko_one"
                android:gravity="center"
                android:text="🌐  Network: Electroneum Testnet"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/profile_qr_image"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/address_text_view"
                android:layout_width="387dp"
                android:layout_height="41dp"
                android:fontFamily="@font/marko_one"
                android:gravity="center"
                android:text="TextView"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/address_layout_linear">

            <Button
                android:id="@+id/btn_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:backgroundTint="@color/text_color_profile"
                android:defaultFocusHighlightEnabled="true"
                android:fontFamily="@font/marko_one"
                android:gravity="start"
                android:hapticFeedbackEnabled="true"
                android:padding="15dp"
                android:text="📝 Instructions"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:strokeColor="#C2185B"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_arbitrum_bridge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:backgroundTint="@color/text_color_profile"
                android:defaultFocusHighlightEnabled="true"
                android:fontFamily="@font/marko_one"
                android:gravity="start"
                android:hapticFeedbackEnabled="true"
                android:padding="15dp"
                android:text="🌉 Electroneum Bridge"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:visibility="gone"
                app:strokeColor="#C2185B"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_private_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:backgroundTint="@color/text_color_profile"
                android:fontFamily="@font/marko_one"
                android:gravity="start"
                android:hapticFeedbackEnabled="true"
                android:padding="15dp"
                android:text="🔑 Private Key"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:strokeColor="#C2185B"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:backgroundTint="@color/text_color_profile"
                android:fontFamily="@font/marko_one"
                android:gravity="start"
                android:hapticFeedbackEnabled="true"
                android:padding="15dp"
                android:text="🖐 Logout"
                android:textColor="#000000"
                android:textSize="16sp"
                app:strokeColor="#C2185B"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Background gradient -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#3F51B5"
                android:endColor="#1A237E"
                android:angle="90" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Inner glossy effect -->
    <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#80FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="90" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Border for the slot display -->
    <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#121212" />
            <corners android:radius="10dp" />
            <stroke
                android:width="3dp"
                android:color="#FFD700" />
        </shape>
    </item>

</layer-list>
